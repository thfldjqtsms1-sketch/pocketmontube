{
  "name": "mytube-manager",
  "version": "1.0.0",
  "description": "YouTube Subscription Groups Manager - Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js",
    "collect": "npx tsx scripts/collect-videos.ts",
    "telegram-notify": "npx tsx scripts/send-telegram-notification.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "youtubei.js": "^16.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.278",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
